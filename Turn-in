<!DOCTYPE html>
<html lang="it">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="theme-color" content="#0C0E13">
<meta name="apple-mobile-web-app-capable" content="yes">
<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'%3E%3Crect width='100' height='100' rx='26' fill='%230C0E13'/%3E%3Ccircle cx='50' cy='50' r='30' fill='none' stroke='%232a3142' stroke-width='9'/%3E%3Cpath d='M50 20a30 30 0 0 1 28 40' fill='none' stroke='%238AB4FF' stroke-width='9' stroke-linecap='round'/%3E%3C/svg%3E">
<title>Turno — quanto manca</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Sora:wght@200;300;400;600&family=Manrope:wght@400;500;700&display=swap" rel="stylesheet">
<style>
:root{--bg:#0C0E13;--s1:#141821;--s2:#1B2130;--line:#252C3D;--tx:#E9ECF3;--dim:#8F99AD;--faint:#5C667A;--ac:#8AB4FF;--ac2:#5EE0B0;--warn:#F2B35E;--bad:#F27A7A;--on:#0C0E13}
:root[data-t=light]{--bg:#F4F5F8;--s1:#fff;--s2:#EBEEF4;--line:#DDE1EA;--tx:#12151C;--dim:#5B6578;--faint:#8E97A8;--ac:#2F5BFF;--ac2:#0F8A5C;--warn:#B8741A;--bad:#D14B4B;--on:#fff}
*{box-sizing:border-box;-webkit-tap-highlight-color:transparent}
body{margin:0;background:var(--bg);color:var(--tx);font-family:Manrope,sans-serif;min-height:100vh;padding-top:env(safe-area-inset-top,0)}
.app{max-width:500px;margin:0 auto;padding:0 18px calc(100px + env(safe-area-inset-bottom,0))}
h2,h3,.so{font-family:Sora,sans-serif}
button{font-family:inherit;color:inherit}
:focus-visible{outline:2px solid var(--ac);outline-offset:2px}
header{display:flex;justify-content:space-between;align-items:center;padding:18px 0 4px}
.logo{font:600 1.15rem Sora;letter-spacing:.02em}
.hr{display:flex;gap:8px}
.ib{width:40px;height:40px;border-radius:12px;border:1px solid var(--line);background:var(--s1);font-size:1.05rem;cursor:pointer}
.ring{position:relative;width:min(78vw,300px);margin:18px auto 6px}
.ring svg{display:block;width:100%}
.ring .in{position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center}
.lab{font-size:.78rem;color:var(--dim);max-width:62%}
.cnt{font:200 clamp(5.4rem,26vw,7.4rem)/1 Sora;letter-spacing:-.05em;margin:2px 0}
.lab2{font:400 .95rem Sora;color:var(--ac)}
.trio{display:grid;grid-template-columns:repeat(3,1fr);margin:16px 0 4px;text-align:center}
.trio div+div{border-left:1px solid var(--line)}
.trio b{display:block;font:300 1.9rem Sora;letter-spacing:-.03em}
.trio span{font-size:.74rem;color:var(--dim)}
.quote{display:block;width:100%;text-align:left;background:none;border:0;border-left:2px solid var(--ac);padding:4px 0 4px 14px;margin:20px 0 6px;font:500 1rem/1.45 Manrope;color:var(--tx);cursor:pointer}
.quote small{display:block;font-size:.7rem;color:var(--faint);margin-top:4px}
.date{font-size:.8rem;color:var(--dim);text-align:center;margin-top:10px}
.card{background:var(--s1);border:1px solid var(--line);border-radius:20px;padding:18px;margin-top:12px}
.card h2{margin:0 0 4px;font-size:1.05rem;font-weight:600}
.card h3{margin:0 0 6px;font:600 .8rem Manrope;color:var(--dim)}
.big{font:300 2.3rem/1.05 Sora;letter-spacing:-.03em;margin:4px 0 6px}
.sub{font-size:.88rem;color:var(--dim);line-height:1.45}
.sub b{color:var(--tx)}
.bar{height:6px;background:var(--s2);border-radius:99px;overflow:hidden;margin:10px 0 4px}
.bar i{display:block;height:100%;background:var(--ac);border-radius:99px}
.bar.g i{background:var(--ac2)}
.tap{display:flex;justify-content:space-between;gap:10px;padding:9px 0;border-bottom:1px solid var(--line);font-size:.9rem}
.tap:last-child{border:0}.tap span{color:var(--dim)}.tap.ok b{color:var(--ac2)}
.acts{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-top:12px}
.btn{width:100%;padding:13px;border-radius:14px;border:0;background:var(--ac);color:var(--on);font:700 .92rem Manrope;cursor:pointer}
.btn.sec{background:var(--s2);color:var(--tx);border:1px solid var(--line)}
.btn.sm{padding:8px 12px;font-size:.8rem;width:auto;border-radius:10px}
nav{position:fixed;left:50%;bottom:calc(14px + env(safe-area-inset-bottom,0));transform:translateX(-50%);display:flex;gap:2px;background:var(--s1);border:1px solid var(--line);padding:4px;border-radius:99px;z-index:20;box-shadow:0 12px 32px rgba(0,0,0,.35)}
nav button{border:0;background:none;padding:10px 18px;border-radius:99px;font:600 .86rem Manrope;color:var(--dim);cursor:pointer}
nav button.on{background:var(--ac);color:var(--on)}
.ch{display:flex;align-items:center;gap:8px;margin-bottom:12px}
.ch h2{flex:1;font-size:1.3rem;text-transform:capitalize}
.sq{background:var(--s2);border:1px solid var(--line);border-radius:10px;min-width:36px;height:36px;padding:0 11px;cursor:pointer;font-weight:700}
.grid{display:grid;grid-template-columns:repeat(7,1fr);gap:5px}
.dow{font-size:.7rem;color:var(--faint);text-align:center;font-weight:700}
.day{position:relative;aspect-ratio:1;border-radius:12px;border:1.5px solid transparent;background:var(--s2);font:400 .9rem Sora;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:3px;cursor:pointer;padding:0}
.day small{font:500 .52rem Manrope;line-height:1;color:var(--dim)}
.day i{width:4px;height:4px;border-radius:50%;background:var(--ac)}
.day.off{background:transparent;color:var(--faint)}
.day.fest{background:transparent;color:var(--bad)}
.day.ferie{background:rgba(94,224,176,.14);border-color:var(--ac2)}
.day.perm{background:rgba(242,179,94,.14);border-color:var(--warn)}
.day.libero{background:transparent;color:var(--faint);text-decoration:line-through}
.day.extra{background:rgba(138,180,255,.16);border-color:var(--ac)}
.day.today{outline:2px solid var(--tx);outline-offset:1px}
.day.pd:after{content:"€";position:absolute;top:2px;right:4px;font:700 .6rem Manrope;color:var(--ac2)}
.day.nt:before{content:"";position:absolute;top:5px;left:5px;width:5px;height:5px;border-radius:50%;background:var(--warn)}
.day.blank{visibility:hidden}
.leg{display:flex;flex-wrap:wrap;gap:6px 14px;margin-top:14px;font-size:.72rem;color:var(--dim)}
.leg span:before{content:"";display:inline-block;width:9px;height:9px;border-radius:3px;margin-right:6px;background:var(--c);vertical-align:-1px}
.rows div{display:flex;justify-content:space-between;gap:12px;padding:10px 0;border-bottom:1px solid var(--line);font-size:.9rem}
.rows div:last-child{border:0}.rows span{color:var(--dim)}
.mr{padding:11px 0;border-bottom:1px solid var(--line)}.mr:last-child{border:0}
.mh{display:flex;justify-content:space-between;font-size:.9rem;font-weight:700}
.mh span+span{font-weight:500;color:var(--dim)}
.mr.cur .mh span:first-child{color:var(--ac)}
.ms{font-size:.76rem;color:var(--dim)}
.br{display:flex;justify-content:space-between;align-items:center;gap:10px;padding:11px 0;border-bottom:1px solid var(--line);font-size:.88rem}
.br:last-child{border:0}.br span{color:var(--dim);font-size:.78rem;display:block}
.ov{position:fixed;inset:0;background:rgba(0,0,0,.6);display:none;align-items:flex-end;justify-content:center;z-index:50}
.ov.open{display:flex}
.sheet{background:var(--s1);border:1px solid var(--line);border-radius:24px 24px 0 0;width:100%;max-width:500px;max-height:92vh;overflow:auto;padding:20px 18px calc(22px + env(safe-area-inset-bottom,0))}
.sh{display:flex;justify-content:space-between;align-items:center;margin-bottom:14px}
.sh h3{margin:0;font:600 1.2rem Sora;text-transform:capitalize;color:var(--tx)}
.sec-t{font:600 .75rem Manrope;color:var(--ac);margin:18px 0 8px}
.f{margin-bottom:11px}
.f label{display:block;font-size:.76rem;color:var(--dim);margin-bottom:5px}
.f input[type=text],.f input[type=number],.f input[type=date],.f input[type=time]{width:100%;background:var(--s2);border:1.5px solid var(--line);border-radius:12px;color:var(--tx);padding:11px;font:inherit;font-size:.93rem;color-scheme:dark light}
.f input:focus{border-color:var(--ac);outline:0}
.row2{display:grid;grid-template-columns:1fr 1fr;gap:10px}
.chips,.seg{display:flex;gap:6px}
.chip,.seg button{flex:1;padding:10px 0;border-radius:11px;border:1px solid var(--line);background:var(--s2);font-weight:700;font-size:.85rem;cursor:pointer;color:var(--dim)}
.chip.on,.seg button.on{background:var(--ac);color:var(--on);border-color:var(--ac)}
.opts{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin:4px 0 10px}
.chk{display:flex;align-items:center;gap:10px;font-size:.88rem;margin:4px 0 12px}
.chk input{width:19px;height:19px;accent-color:var(--ac)}
.hint{font-size:.74rem;color:var(--faint);margin:4px 0 0;line-height:1.4}
.err{color:var(--bad);font-size:.82rem;min-height:1.1em;margin-bottom:8px;font-weight:700}
#toast{position:fixed;left:50%;bottom:calc(84px + env(safe-area-inset-bottom,0));transform:translateX(-50%);background:var(--tx);color:var(--bg);padding:10px 16px;border-radius:12px;font-size:.86rem;font-weight:600;opacity:0;pointer-events:none;transition:opacity .25s;z-index:99}
#toast.on{opacity:1}
[hidden]{display:none!important}
@media (prefers-reduced-motion:reduce){*{transition:none!important}}
nav button{padding:10px 13px}
.rows b{text-align:right}
#fk{position:fixed;inset:0;z-index:200;background:#000;display:flex;flex-direction:column;padding:env(safe-area-inset-top,0) 12px calc(14px + env(safe-area-inset-bottom,0));font-family:-apple-system,Helvetica,Arial,sans-serif}
#fkD{flex:1;display:flex;align-items:flex-end;justify-content:flex-end;color:#fff;font-size:4.2rem;font-weight:300;padding:10px 8px;word-break:break-all;text-align:right;user-select:none}
#fkK{display:grid;grid-template-columns:repeat(4,1fr);gap:10px;max-width:420px;width:100%;margin:0 auto}
#fkK button{aspect-ratio:1;border:0;border-radius:50%;background:#333;color:#fff;font-size:1.7rem}
#fkK button:nth-child(4n){background:#ff9f0a}
.lock{opacity:.4}
</style>
</head>
<body>
<div class="app">
  <header><div class="logo">turno</div><div class="hr"><button class="ib" onclick="panic(1)" aria-label="Nascondi app">▦</button><button class="ib" id="thBtn" onclick="cycleTheme()" aria-label="Cambia tema">◐</button><button class="ib" onclick="openCfg()" aria-label="Impostazioni">⚙︎</button></div></header>
  <main id="v-home"></main>
  <main id="v-cal" hidden>
    <section class="card" style="margin-top:14px">
      <div class="ch"><h2 id="mTitle"></h2><button class="sq" onclick="goToday()">Oggi</button><button class="sq" onclick="shift(-1)" aria-label="Mese precedente">‹</button><button class="sq" onclick="shift(1)" aria-label="Mese successivo">›</button></div>
      <div class="grid" id="dows"></div><div class="grid" id="cal" style="margin-top:5px"></div>
      <div class="leg"><span style="--c:var(--ac)">Lavoro extra</span><span style="--c:var(--ac2)">Ferie</span><span style="--c:var(--warn)">Permesso / nota</span><span style="--c:var(--bad)">Festività</span></div>
      <p class="hint">€ = giorno di paga. Tocca un giorno per ferie, permessi, note.</p>
    </section>
    <section class="card"><h2 id="msTitle" style="text-transform:capitalize"></h2><div class="rows" id="mStats"></div></section>
  </main>
  <main id="v-x" hidden></main>
  <main id="v-stats" hidden><div id="sAll"></div></main>
</div>
<nav><button id="n-home" class="on" onclick="go('home')">Conto</button><button id="n-cal" onclick="go('cal')">Calendario</button><button id="n-stats" onclick="go('stats')">Statistiche</button><button id="n-x" onclick="go('x')">Extra</button></nav>

<div class="ov" id="ov-day" onclick="if(event.target===this)closeS('day')"><div class="sheet">
  <div class="sh"><h3 id="dTitle"></h3><button class="ib" onclick="closeS('day')" aria-label="Chiudi">✕</button></div>
  <p id="dState" class="sub" style="margin:0 0 14px"></p>
  <div class="row2">
    <div class="f"><label>Ore (permesso: assenza · extra: lavorate)</label><input type="number" id="dH" step="0.5" min="0" inputmode="decimal"></div>
    <div class="f"><label>Fino al giorno (facoltativo)</label><input type="date" id="dEnd"></div>
  </div>
  <div class="f"><label>Nota per questo giorno (facoltativa)</label><input type="text" id="dNote" maxlength="120" placeholder="Es. visita, colloquio, cena"></div>
  <div class="err" id="dErr"></div>
  <div class="opts">
    <button class="btn sec" onclick="apply('ferie')">🌴 Ferie</button><button class="btn sec" onclick="apply('perm')">⏱ Permesso</button>
    <button class="btn sec" onclick="apply('extra')">➕ Lavoro extra</button><button class="btn sec" onclick="apply('libero')">🛋 Giorno libero</button>
  </div>
  <div class="opts"><button class="btn sec" onclick="saveNote()">Salva solo la nota</button><button class="btn" onclick="apply('reset')">Giorno normale</button></div>
</div></div>

<div class="ov" id="ov-cfg" onclick="if(event.target===this)closeS('cfg')"><div class="sheet">
  <div class="sh"><h3>Impostazioni</h3><button class="ib" onclick="closeS('cfg')" aria-label="Chiudi">✕</button></div>
  <div class="sec-t" style="margin-top:0">Traguardo</div>
  <div class="f"><label>Cosa stai aspettando?</label><input type="text" id="cLabel" maxlength="40" placeholder="Es. Fine contratto, Vacanze"></div>
  <div class="row2"><div class="f"><label>Data di arrivo</label><input type="date" id="cEnd"></div><div class="f"><label>Data di partenza</label><input type="date" id="cStart"></div></div>
  <div class="sec-t">Orario</div>
  <div class="f"><div class="seg"><button type="button" id="md-week" onclick="setMode('week')">Settimana fissa</button><button type="button" id="md-cycle" onclick="setMode('cycle')">Turni a ciclo</button></div></div>
  <div id="wkBox" class="f"><label>Giorni in cui lavori di solito</label><div class="chips" id="cDays"></div></div>
  <div id="cyBox"><div class="row2"><div class="f"><label>Giorni di lavoro di fila</label><input type="number" id="cOn" min="1" step="1" inputmode="numeric"></div><div class="f"><label>Giorni di riposo di fila</label><input type="number" id="cOff" min="0" step="1" inputmode="numeric"></div></div>
  <div class="f"><label>Primo giorno di lavoro di un ciclo</label><input type="date" id="cCy"></div><p class="hint" style="margin:-4px 0 10px">Es. 4 giorni di lavoro e 2 di riposo, a partire da una data qualsiasi in cui hai iniziato un ciclo.</p></div>
  <div class="f"><label>Ore al giorno</label><input type="number" id="cHours" step="0.5" min="0" inputmode="decimal"></div>
  <div class="sec-t">Paga</div>
  <div class="f"><div class="seg"><button type="button" id="pm-hour" onclick="setPM('hour')">All'ora</button><button type="button" id="pm-month" onclick="setPM('month')">Al mese</button></div></div>
  <div class="row2"><div class="f"><label id="cPayL">Paga all'ora (€)</label><input type="number" id="cPay" step="0.01" min="0" inputmode="decimal"></div><div class="f"><label>Giorno di paga (1-31)</label><input type="number" id="cPayday" step="1" min="0" max="31" inputmode="numeric"></div></div>
  <p class="hint" style="margin:-4px 0 10px">31 = ultimo giorno del mese. Vuoto = nessun giorno di paga.</p>
  <label class="chk"><input type="checkbox" id="cPayAdj"> Se cade nel weekend o in una festa, pagano il giorno lavorativo prima</label>
  <div class="sec-t">Obiettivo</div>
  <div class="row2"><div class="f"><label>Soldi che hai adesso (€)</label><input type="number" id="cSaved" step="1" min="0" inputmode="decimal"></div><div class="f"><label>Ferie all'anno (giorni)</label><input type="number" id="cFerie" step="1" min="0" inputmode="numeric"></div></div>
  <div class="row2"><div class="f"><label>Cosa vuoi fare/comprare?</label><input type="text" id="cGoalN" maxlength="30" placeholder="Es. Viaggio, Auto"></div><div class="f"><label>Quanto serve (€)</label><input type="number" id="cGoalA" step="1" min="0" inputmode="decimal"></div></div>
  <label class="chk"><input type="checkbox" id="cHol"> Escludi le festività italiane</label>
  <div class="sec-t">Per le stime (TFR, NASpI, ferie)</div>
  <div class="row2"><div class="f"><label>Data di assunzione</label><input type="date" id="cHire"></div><div class="f"><label>Inizio turno</label><input type="time" id="cStT"></div></div>
  <div class="row2"><div class="f"><label>RAL lorda annua (€)</label><input type="number" id="cRal" step="100" min="0" inputmode="decimal"></div><div class="f"><label>Ferie/ROL residui (giorni)</label><input type="number" id="cResid" step="0.5" min="0" inputmode="decimal"></div></div>
  <div class="f"><label>Settimane contributive altrove (ultimi 4 anni)</label><input type="number" id="cPrev" step="1" min="0" inputmode="numeric"></div>
  <label class="chk"><input type="checkbox" id="cShake"> Scuoti il telefono per trasformare l'app in una calcolatrice</label>
  <p class="hint">La RAL (dal contratto o dalla busta paga) serve per TFR e NASpI. Tutto resta su questo dispositivo.</p>
  <div class="sec-t">Aspetto</div>
  <div class="f"><div class="seg"><button type="button" id="th-auto" onclick="setTh('auto')">Automatico</button><button type="button" id="th-dark" onclick="setTh('dark')">Scuro</button><button type="button" id="th-light" onclick="setTh('light')">Chiaro</button></div></div>
  <button class="btn" style="margin-top:6px" onclick="saveCfg()">Salva</button>
  <div class="opts" style="margin-top:10px"><button class="btn sec" onclick="exp()">Scarica backup</button><button class="btn sec" onclick="document.getElementById('cFile').click()">Ripristina backup</button></div>
  <input type="file" id="cFile" accept="application/json" hidden onchange="imp(this.files[0])">
  <p class="hint">I dati restano su questo dispositivo. Scarica un backup ogni tanto per non perderli o per spostarli su un altro telefono.</p>
</div></div>
<div id="fk" hidden><div id="fkD" onpointerdown="fkT=setTimeout(()=>panic(0),800)" onpointerup="clearTimeout(fkT)" onpointerleave="clearTimeout(fkT)">0</div><div id="fkK"></div></div>
<div id="toast"></div>

<script>
const KEY = 'turno_v1';
const D0 = { cfg: { mode: 'week', days: [1,2,3,4,5], cycleOn: 5, cycleOff: 2, cycleStart: '', hours: 8, rate: 0, monthly: 0, payMode: 'hour', payday: 0, payAdj: true, saved: 0, goalName: '', goalAmt: 0, end: '', start: '', label: 'Fine contratto', hol: true, ferie: 0, theme: 'auto', hire: '', stT: '09:00', ral: 0, prev: 0, resid: 0, shake: false }, ex: {}, notes: {}, mood: {}, chk: {} };
const MESI = ['gennaio','febbraio','marzo','aprile','maggio','giugno','luglio','agosto','settembre','ottobre','novembre','dicembre'];
const $ = (id) => document.getElementById(id);
const p2 = (n) => String(n).padStart(2, '0');
const ymd = (d) => `${d.getFullYear()}-${p2(d.getMonth() + 1)}-${p2(d.getDate())}`;
const parse = (s) => { const [y, m, d] = s.split('-').map(Number); return new Date(y, m - 1, d); };
const ud = (d) => Date.UTC(d.getFullYear(), d.getMonth(), d.getDate());
const dd = (a, b) => Math.round((ud(b) - ud(a)) / 864e5);
const eur = (n) => n.toLocaleString('it-IT', { style: 'currency', currency: 'EUR', minimumFractionDigits: 0, maximumFractionDigits: 2 });
const fh = (n) => String(Math.round(n * 10) / 10).replace('.', ',');
const fdate = (d) => d.toLocaleDateString('it-IT', { day: 'numeric', month: 'long', year: 'numeric' });
const fshort = (d) => d.toLocaleDateString('it-IT', { weekday: 'short', day: 'numeric', month: 'short' });
const esc = (s) => String(s).replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
const todayD = () => { const t = new Date(); return new Date(t.getFullYear(), t.getMonth(), t.getDate()); };
const addD = (d, n) => { const x = new Date(d); x.setDate(x.getDate() + n); return x; };

function load() {
  try { const r = JSON.parse(localStorage.getItem(KEY)); if (r && r.cfg) return { cfg: { ...D0.cfg, ...r.cfg }, ex: r.ex || {}, notes: r.notes || {}, mood: r.mood || {}, chk: r.chk || {} }; } catch (e) {}
  return JSON.parse(JSON.stringify(D0));
}
let S = load(), bump = 0, sel = null, first = true;
let view = new Date(); view = new Date(view.getFullYear(), view.getMonth(), 1);
function save() { try { localStorage.setItem(KEY, JSON.stringify(S)); } catch (e) { toast('Impossibile salvare su questo browser.'); } applyTheme(); render(); }

/* ---------- tema ---------- */
const mq = matchMedia('(prefers-color-scheme: light)');
function applyTheme() {
  const t = S.cfg.theme === 'auto' ? (mq.matches ? 'light' : 'dark') : S.cfg.theme;
  document.documentElement.dataset.t = t;
  document.querySelector('meta[name=theme-color]').content = t === 'light' ? '#F4F5F8' : '#0C0E13';
  $('thBtn').textContent = { auto: '◐', dark: '☾', light: '☀' }[S.cfg.theme];
}
mq.addEventListener && mq.addEventListener('change', applyTheme);
